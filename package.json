{
	"name": "eql4e-tickets",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "DATABASE_URL=${DATABASE_URL:-postgres://compilacion@localhost/compilacion} vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project unitarias",
		"test": "vitest run --project unitarias && pnpm test:integracion && pnpm test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"test:integracion": "vitest run --project integracion",
		"test:cobertura": "vitest run --project unitarias --coverage",
		"db:migrar": "node scripts/migrar.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@testcontainers/postgresql": "^12.2.1",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1",
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"zod": "^4.6.7"
	}
}
