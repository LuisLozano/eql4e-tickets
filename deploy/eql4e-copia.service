# Copia de seguridad diaria de eql4e-tickets (ADR-0008). Se instala en /etc/systemd/system.
[Unit]
Description=Copia de seguridad de eql4e-tickets
Requires=docker.service
After=docker.service
# Espera a que se monten los dos discos de copias, sin exigirlos: si falta uno, copia.sh copia en el
# otro y termina con error (se ve en systemctl status y en el journal).
Wants=mnt-eql4e_copias.mount mnt-externalHD.mount
After=mnt-eql4e_copias.mount mnt-externalHD.mount

[Service]
Type=oneshot
ExecStart=/opt/eql4e-tickets/copia.sh
