# Lanza eql4e-copia.service cada día a las 19:30: antes de la copia de Salazar (20:00) y del apagado
# programado (20:20). Si el equipo estaba apagado a esa hora, al arrancar (Persistent).
[Unit]
Description=Copia de seguridad diaria de eql4e-tickets

[Timer]
OnCalendar=*-*-* 19:30
Persistent=true

[Install]
WantedBy=timers.target
