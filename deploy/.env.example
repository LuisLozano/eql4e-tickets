# Configuración de PRODUCCIÓN. Copia a /opt/eql4e-tickets/.env con permisos 600.
# Nunca subas el .env a git.

# Etiqueta de la imagen en GHCR: latest o el SHA corto de un commit (para volver atrás).
ETIQUETA=latest

# Contraseña de PostgreSQL. Genera una con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Correo (ADR-0004). Hasta tener la contraseña de aplicación del Gmail de la asociación, deja consola.
CORREO_MODO=consola
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
