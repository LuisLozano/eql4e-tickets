# Variables de entorno de eql4e-tickets (docs/arquitectura/04-estructura.md).
# Copia este fichero a .env y rellénalo. El .env NUNCA se sube a git.

# --- Base de datos ---
# En desarrollo: el PostgreSQL de deploy/compose.dev.yaml (puerto 5436 en localhost).
DATABASE_URL=postgres://eql4e:eql4e@127.0.0.1:5436/eql4e
# Pruebas de integración en local (crea y borra una base de datos temporal por ejecución).
TEST_DATABASE_URL=postgres://eql4e:eql4e@127.0.0.1:5436/postgres

# --- Ficheros ---
RUTA_FICHEROS=./.datos/ficheros

# --- Correo (ADR-0004) ---
# consola: no envía nada, escribe el correo en el log. smtp: envía de verdad.
CORREO_MODO=consola
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Contraseña de aplicación de Google (no la contraseña de la cuenta).
SMTP_PASS=
SMTP_FROM=
